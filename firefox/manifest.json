{
  "manifest_version": 2,
  "name": "Partouche Auto-Player",
  "version": "2.0.0",
  "description": "Automates daily bonuses, wheel spins, and slot play on Partouche Online",
  "browser_specific_settings": {
    "gecko": {
      "id": "partouche-autoplayer@definitely-not-a-casino-bot",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "https://online.partouche.com/*",
    "https://jeux-v2.ptech.fr/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://online.partouche.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jeux-v2.ptech.fr/*"],
      "js": ["game-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Partouche Auto-Player",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    "game-bot-inject.js"
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
